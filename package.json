{
  "name": "react-corruption",
  "version": "0.1.0",
  "private": false,
  "description": "Interactive pixel corruption for React.",
  "keywords": [
    "react",
    "pixel",
    "corruption",
    "glitch",
    "canvas",
    "effect",
    "animation"
  ],
  "license": "MIT",
  "author": "Gracie Gould",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/graciegould/react-corruption.git"
  },
  "bugs": {
    "url": "https://github.com/graciegould/react-corruption/issues"
  },
  "homepage": "https://github.com/graciegould/react-corruption#readme",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "tsup --watch",
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc --noEmit -p demo/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "demo": "pnpm run build && vite --config demo/vite.config.ts",
    "demo:dev": "vite --config demo/vite.config.ts",
    "test:browser": "node demo/verify.mjs",
    "test:engine": "node scripts/verify-setsource.mjs && node scripts/verify-motion.mjs",
    "prepack": "pnpm verify && pnpm build",
    "test:video": "node demo/verify-video.mjs",
    "test:package": "node scripts/verify-package.mjs"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.37.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright-core": "1.58.2",
    "prettier": "^3.6.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1"
  },
  "packageManager": "pnpm@12.4.2"
}
